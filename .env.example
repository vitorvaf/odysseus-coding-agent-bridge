# OCAB Coding Agent Bridge — environment overrides.
# Copy to .env and replace __SET_ME__ placeholders with real values.
# Do NOT commit a real .env; it is excluded by .gitignore.

OCAB_MCP_TOKEN=__SET_ME__
OCAB_PG_PASSWORD=__SET_ME__

# SLICE-STAB-002 / ADR-0017: Basic Auth password for the OpenCode
# runner (consumed by OPENCODE_SERVER_PASSWORD inside the container).
# The bridge reads the same value via OCAB_OPENCODE_SERVER_PASSWORD
# to send `Authorization: Basic opencode:<value>` on every request.
OCAB_OPENCODE_SERVER_PASSWORD=__SET_ME__
